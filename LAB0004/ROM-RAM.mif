-- Quartus II generated Memory Initialization File (.mif)

WIDTH=32;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
	000  :   00000000;
	001  :   30000001;
	002  :   40000002;
	003  :   50000003;
	004  :   60000004;
	005  :   20000007;
	006  :   70000009;
	007  :   10000004;
	[008..009]  :   00000000;
	00A  :   10000000;
	[00B..010]  :   00000000;
	011  :   08000008;
	[012..0FF]  :   00000000;
END;
